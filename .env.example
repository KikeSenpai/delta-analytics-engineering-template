# Copy to .env — `just` loads it (set dotenv-load) for Docker Compose and dbt.

# Spark Thrift Server (dbt-spark dev target)
SPARK_THRIFT_HOST=localhost
SPARK_THRIFT_PORT=10000

# MinIO root credentials (required — MinIO stores every Delta table).
# Unity Catalog vends these to Spark for s3://delta-warehouse; Spark has no keys of its own.
# Applied when the minio-data volume is first created; after changing them run `just clean`.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

# Prod: Databricks connection (for profiles.yml prod target)
# DATABRICKS_HOST=your-workspace.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/00000000-0000-0000-0000-000000000000
