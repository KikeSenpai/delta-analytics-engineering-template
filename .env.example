# Unity Catalog
UC_HOST=localhost
UC_PORT=8081
UC_CATALOG=main

# Spark Thrift Server
SPARK_THRIFT_HOST=localhost
SPARK_THRIFT_PORT=10000

# Delta Lake + Unity Catalog versions (must match docker-compose)
DELTA_SPARK_VERSION=4.1.0
UC_VERSION=0.4.0

# MinIO (optional — enable with: docker compose --profile minio up)
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
MINIO_ENDPOINT=http://minio:9000

# Prod: Databricks connection (for profiles.yml prod target)
# DATABRICKS_HOST=your-workspace.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/00000000-0000-0000-0000-000000000000
