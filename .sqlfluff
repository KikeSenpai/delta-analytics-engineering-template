[sqlfluff]
dialect = sparksql
templater = jinja

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:templater:jinja:macros]
dbt_ref = {% macro ref(model_ref) %}{{ model_ref }}{% endmacro %}
dbt_source = {% macro source(source_name, table_name) %}{{ source_name }}_{{ table_name }}{% endmacro %}
dbt_config = {% macro config() %}{% for k in kwargs %}{% endfor %}{% endmacro %}
dbt_var = {% macro var(variable, default='') %}{{ default }}{% endmacro %}
dbt_is_incremental = {% macro is_incremental() %}true{% endmacro %}

[sqlfluff:rules:capitalisation.keywords]
capitalisation_keywords = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_identifiers = lowercase

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_functions = upper

[sqlfluff:rules:layout.long_lines]
max_line_length = 120

[sqlfluff:rules:ambiguous.column_count]
# dbt SELECT * is common in staging — skip ambiguous column count
disable = true
