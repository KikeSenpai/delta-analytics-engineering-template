#!/usr/bin/env bash
set -euo pipefail

# Start dockerd (declared in .amp/services.yaml) if it is not already running.
# Idempotent: ensure never duplicates or restarts a running service.
amp orb services ensure

# ensure returns as soon as dockerd is launched; the API socket follows 1-3 s later.
# Block until Docker answers so the agent never races it. Amp waits up to 10 s for
# this hook, so the default bound keeps a failure visible instead of backgrounded.
timeout="${DOCKER_WAIT_TIMEOUT:-8}"
deadline=$((SECONDS + timeout))
until err=$(docker info 2>&1 >/dev/null); do
  if ((SECONDS >= deadline)); then
    echo "ERROR: Docker daemon not ready after ${timeout}s: ${err}" >&2
    amp orb service status docker-daemon >&2 || true
    echo "More logs: amp orb service logs docker-daemon" >&2
    echo "Retry: .agents/resume (or DOCKER_WAIT_TIMEOUT=60 .agents/resume)" >&2
    exit 1
  fi
  sleep 0.5
done
echo "Docker daemon ready."
